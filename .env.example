# Clerk (https://dashboard.clerk.com). Optional in local dev: without keys Clerk runs in "keyless" mode.
# Enable LinkedIn + Google as social connections in the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Postgres (Neon / Render / Supabase). Leave empty locally to use embedded PGlite in ./.pglite
DATABASE_URL=
# Run migrations on boot (handy for first deploy). Otherwise: npm run db:migrate
AUTO_MIGRATE=false

# Claude, for matchmaking reasons and openers. Without it, matching falls back to simple rules.
ANTHROPIC_API_KEY=

# Daily.co for video rooms. Without it, meetings get a Jitsi link.
DAILY_API_KEY=
